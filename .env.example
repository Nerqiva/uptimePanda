# uptimePanda deployment configuration (environment contract)
#
# This file is committed and is scanned by PaaS platforms (e.g. Dokploy,
# Coolify, CapRover) to pre-fill environment forms. Every variable here
# belongs to the deployment itself — paths, ports, bind address, timezone,
# logging, and the two secrets. Everything else (all monitoring, memory,
# scheduler, interaction, retention, and UI-level knobs) lives in the
# application's Settings page and is stored in the SQLite database
# (application_settings table), NOT in this file.
#
# Copy to .env for local development and adjust. NEVER commit a real .env.

APP_PASSWORD=change-me          # Dashboard login password. REQUIRED. Min 12 characters.
ENCRYPTION_KEY=change-me        # Passphrase for cookie encryption at rest (scrypt -> AES-256-GCM). REQUIRED. Min 16 characters.
DATABASE_PATH=/app/data/uptimepanda.db   # SQLite database path (container default; dev default is ./data/uptimepanda.db)
BACKUP_DIR=/app/data/backups             # Directory for database backups (container default; dev default is ./data/backups)
PORT=8080                       # HTTP listen port. Default 8080.
BIND_ADDR=0.0.0.0               # Bind address. Containers need 0.0.0.0; 127.0.0.1 is the deb/local-dev default.
TZ=Asia/Omsk                   # Timezone (IANA name). Default Asia/Omsk (UTC+6).
RUST_LOG=info                   # Log level / EnvFilter directive (trace|debug|info|warn|error). Default info.
